# GoMina 360 — production environment variables
#
# Copy this file to `.env.local` for local dev, or configure these in
# Vercel → Settings → Environment Variables for each deployment target
# (Production / Preview / Development).
#
# Only ONE of DATABASE_URL / POSTGRES_PRISMA_URL / POSTGRES_URL /
# POSTGRES_URL_NON_POOLING is required — the server picks the first set
# one it finds. DATABASE_URL is recommended.

# Primary PostgreSQL connection string (Neon / Vercel Postgres / Supabase / RDS).
# Example: postgresql://user:pwd@host:5432/gomina360?sslmode=require
DATABASE_URL=

# Vapid keys for browser push notifications (generate with `npx web-push generate-vapid-keys`).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gomina360.app

# Optional: force the server to refuse loopback DATABASE_URLs on
# managed hosts (auto-enabled when VERCEL=1, which Vercel sets).
# REQUIRE_EXTERNAL_DB=true

# Optional: disable the demo/seed initial provisioning on a fresh DB
# (set to "1" if you are restoring a backup against an empty schema).
# GOMINA_SKIP_SEED=0

# GoMina 360 — production environment variables
#
# Copy this file to `.env.local` for local dev, or configure these in
# Vercel → Settings → Environment Variables for each deployment target
# (Production / Preview / Development).
#
# Only ONE of DATABASE_URL / POSTGRES_PRISMA_URL / POSTGRES_URL /
# POSTGRES_URL_NON_POOLING is required — the server picks the first set
# one it finds. DATABASE_URL is recommended.

# Primary PostgreSQL connection string (Neon / Vercel Postgres / Supabase / RDS).
# Example: postgresql://user:pwd@host:5432/gomina360?sslmode=require
DATABASE_URL=

# ── Browser push notifications ──
# NOTHING TO CONFIGURE: the group-wide VAPID keypair is generated once on first
# use and stored in the database (push_config), and the public key reaches the
# browser through GET /api/push/vapid. The three variables below are legacy and
# are NOT read by any code path — leave them unset.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# ── Scheduled daily pipeline (REQUIRED for Vercel Cron) ──
# vercel.json registers GET /api/cron/daily at 06:00 UTC. Set this to a long
# random string and Vercel Cron automatically sends it as
# `Authorization: Bearer $CRON_SECRET` on every invocation. Without it the
# endpoint FAILS CLOSED (401) — daily digests/escalations then only run through
# the /api/init pull-based fallback on the first sign-in of the day.
# Generate: openssl rand -hex 32
# CRON_SECRET=

# Optional: force the server to refuse loopback DATABASE_URLs on
# managed hosts (auto-enabled when VERCEL=1, which Vercel sets).
# REQUIRE_EXTERNAL_DB=true

# Optional: disable the demo/seed initial provisioning on a fresh DB
# (set to "1" if you are restoring a backup against an empty schema).
# GOMINA_SKIP_SEED=0

# ── Optional hardening / tuning (all have production-safe defaults) ──

# Salt used to hash client IPs in logs/audit rows (GDPR-friendly logging).
# Set a long random string per deployment; falls back to a built-in dev salt.
# IP_HASH_SALT=

# Postgres pool size and TLS mode when your managed DB needs them.
# PG_POOL_MAX=10
# PGSSLMODE=require

# Extra frame-ancestors hosts (comma-separated) for legitimately embedding
# the app in another site/dashboard. The E2B preview host is always allowed.
# FRAME_ANCESTORS=https://*.example.com

# Enable HSTS once you serve real TLS in production (leave off for plain
# HTTP sandboxes or the browser refuses to talk to you).
# ENABLE_HSTS=1

# Transport speed alerts threshold (km/h) — server + client must match.
# TRANSPORT_SPEED_LIMIT_KMH=110
# NEXT_PUBLIC_TRANSPORT_SPEED_LIMIT=110

# Verbose DB logging (debug only).
# DB_DEBUG=0

+
+const STATUS_STYLE: Record<string, string> = {
+  IN_PROGRESS: "bg-sky-500/15 text-sky-300 border-sky-500/40",
+  COMPLETED: "bg-emerald-500/15 text-emerald-300 border-emerald-500/40",

+    }
+
+    if (typeof body.managerName === "string" && body.managerName.trim()) {
+      updates.managerName = body.managerName.trim();
+    }
+    if (typeof body.contactPhone === "string" && body.contactPhone.trim()) {
+      updates.contactPhone = body.contactPhone.trim();
+    }

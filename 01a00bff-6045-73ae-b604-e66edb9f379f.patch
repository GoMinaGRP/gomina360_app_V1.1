+        .returning();
+      await bookTransaction(biz, "INCOME", row.priceGhs, "TELECOM_WIFI", `Telecom ${txnNumber}: Wi-Fi voucher ${row.code} (${row.packageName}) — ${row.customerName}`, data.paymentMethod || "CASH", actor.a, actor.r, actor.u);

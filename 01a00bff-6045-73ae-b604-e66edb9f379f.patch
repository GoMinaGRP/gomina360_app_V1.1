+    <Suspense
+      fallback={
+        <div className="min-h-screen bg-slate-950 text-slate-400 flex items-center justify-center text-sm">
+          Loading order tracking…
+        </div>
+      }
+    >
+      <TrackInner />
+    </Suspense>
+  );
+}

+
+    setIsSubmitting(true);
+    try {
+      const res = await fetch("/api/enterprise", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          entityType: "asset",
+          data: {
+            assetCode: assetCode.trim().toUpperCase(),

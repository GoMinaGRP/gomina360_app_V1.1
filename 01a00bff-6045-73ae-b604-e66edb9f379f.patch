+    }
+
+    // ── FEED ───────────────────────────────────────────────────────
+    if (entity === "FEED") {
+      const qty = Number(data.quantityKg) || 0;
+      const costPerKg = Number(data.costPerKgGhs) || 0;
+      const totalCost = Number(data.totalCostGhs) || qty * costPerKg;
+      const [row] = await db
+        .insert(poultryFeedLogs)
+        .values({
+          businessId,
+          branchCode,

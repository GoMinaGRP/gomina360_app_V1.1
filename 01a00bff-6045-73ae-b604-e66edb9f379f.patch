+      const assignee = staff.find((s: any) => String(s.id) === String(newItem.assignedToUserId));
+      const res = await fetch("/api/checklists", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          entity: "TEMPLATE",
+          data: {
+            businessId,
+            branchCode,

+"use client";
+
+import React, { useCallback, useEffect, useMemo, useState } from "react";
+import AiSectionGuide from "./AiSectionGuide";
+import {
+  HardHat, Package, AlertTriangle, TrendingUp, Wallet, Activity, Boxes,

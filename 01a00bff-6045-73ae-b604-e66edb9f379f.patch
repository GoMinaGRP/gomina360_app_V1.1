+  const techSuppliers = useMemo(() => suppliers.filter((s) => /electron|solar|tech|gadget/i.test(s.category || "") || purchases.some((p) => p.supplierName === s.name)), [suppliers, purchases]);
+  const supplierSpend = useMemo(() => {
